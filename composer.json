{
    "name": "nylo/smalljson",
    "description": "Shrink Laravel JSON responses with a compact structural encoding and optional deflate. Adds response()->smallJson() and a drop-in middleware; pairs with the smalljson Dio interceptor for Flutter.",
    "type": "library",
    "keywords": [
        "laravel",
        "json",
        "compression",
        "api",
        "bandwidth",
        "payload",
        "flutter",
        "dio",
        "smalljson"
    ],
    "homepage": "https://github.com/nylo-core/smalljson",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Gordon",
            "email": "support@nylo.dev",
            "homepage": "https://nylo.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SmallJson\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmallJson\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmallJson\\SmallJsonServiceProvider"
            ],
            "aliases": {
                "SmallJson": "SmallJson\\Facades\\SmallJson"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "bench": "@php bin/benchmark.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
